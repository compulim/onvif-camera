# All settings are optional; the values shown are the defaults.
# Uncomment and change only what you need.

# LAN IPv4 address advertised to clients. Defaults to the first non-loopback
# IPv4 address of this host; set it explicitly on multi-homed hosts.
# CAMERA_ADDRESS=
# Unique persistent ID to preserve identity if the IP address changes.
# Defaults to CAMERA_ADDRESS.
# CAMERA_ID=
# CAMERA_NAME=Raspberry Pi Camera
# CAMERA_BIND=0.0.0.0
# CAMERA_PORT=8000
# CAMERA_DISCOVERY=true

# MediaMTX server that serves the stream; may be another machine. The RTSP URL
# returned to ONVIF clients is rtsp://CAMERA_MEDIAMTX_ADDRESS:CAMERA_RTSP_PORT/CAMERA_RTSP_PATH.
# Ports must match rtspAddress, rtpAddress and rtcpAddress in the MediaMTX
# configuration. Defaults to CAMERA_ADDRESS (a local MediaMTX).
# CAMERA_MEDIAMTX_ADDRESS=
# CAMERA_RTSP_PORT=8554
# CAMERA_RTSP_PATH=camera
# RTP port must be even; RTCP port must be RTP port + 1 (defaults to it).
# CAMERA_RTP_PORT=8000
# CAMERA_RTCP_PORT=8001

# Reported by GetDeviceInformation; the model is also advertised as the
# ONVIF hardware scope. Serial number defaults to a hash of CAMERA_ID.
# Firmware version defaults to the onvif-camera package version.
# CAMERA_MANUFACTURER=Raspberry Pi
# CAMERA_MODEL=Camera Module
# CAMERA_FIRMWARE_VERSION=
# CAMERA_SERIAL_NUMBER=
# CAMERA_HARDWARE_ID=onvif-camera

# Advertised over ONVIF only; match the stream published to MediaMTX.
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=30
# CAMERA_BITRATE=20000
# Set false if the published stream has no audio.
# CAMERA_AUDIO=true
# Advertised AAC audio bitrate (kbit/s), sample rate (Hz, e.g. 44100 or
# 48000) and number of channels (1 = mono, 2 = stereo); 16-bit source.
# CAMERA_AUDIO_BITRATE=128
# CAMERA_AUDIO_SAMPLE_RATE=44100
# CAMERA_AUDIO_CHANNELS=2

# Optional ONVIF WS-Security digest authentication: set BOTH values.
# This does NOT protect RTSP; configure reader access in MediaMTX separately.
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
