# Set a static address or DHCP reservation for this Raspberry Pi.
CAMERA_ADDRESS=192.168.1.20
CAMERA_NAME="Raspberry Pi Camera"
# Set a unique persistent ID to preserve identity if the IP address changes.
CAMERA_ID=raspberry-pi-camera-1
CAMERA_PORT=8000
# RTSP URL returned to ONVIF clients; may point to another machine.
# Defaults to rtsp://CAMERA_ADDRESS:8554/camera (the local MediaMTX).
CAMERA_RTSP_URL=rtsp://192.168.1.20:8554/camera
CAMERA_DISCOVERY=true

# Reported by GetDeviceInformation; the model is also advertised as the
# ONVIF hardware scope. Serial number defaults to a hash of CAMERA_ID.
CAMERA_MANUFACTURER=rpi-onvif-camera
CAMERA_MODEL="Raspberry Pi"
CAMERA_FIRMWARE_VERSION=1.0.0
CAMERA_SERIAL_NUMBER=
CAMERA_HARDWARE_ID=rpi-onvif-camera

# Advertised over ONVIF only; match the stream published to MediaMTX.
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_FPS=30
CAMERA_BITRATE=20000
# Set false if the published stream has no audio.
CAMERA_AUDIO=true
# Advertised AAC audio bitrate (kbit/s), sample rate (Hz, e.g. 48000 or
# 44100) and number of channels (1 = mono, 2 = stereo); 16-bit source.
CAMERA_AUDIO_BITRATE=128
CAMERA_AUDIO_SAMPLE_RATE=48000
CAMERA_AUDIO_CHANNELS=2

# Optional ONVIF WS-Security digest authentication: set BOTH values.
# This does NOT protect RTSP; configure reader access in MediaMTX separately.
CAMERA_USERNAME=
CAMERA_PASSWORD=
