# All settings are optional; the values shown are the defaults.
# Uncomment and change only what you need. Settings left empty use the
# computed default described above them.

# LAN IPv4 address advertised to clients; set it explicitly on multi-homed hosts.
# Default: the first non-loopback IPv4 address of this host.
# CAMERA_ADDRESS=
# Unique persistent ID, also reported by GetHostname. Set it to preserve the
# camera identity if the IP address changes.
# Default: the value of CAMERA_ADDRESS.
# CAMERA_ID=
# CAMERA_NAME=onvif-camera
# CAMERA_BIND=0.0.0.0
# CAMERA_PORT=8000
# CAMERA_DISCOVERY=true
# Log the SOAP request and response bodies of every HTTP request, in addition
# to the method, path, operation and HTTP status code. Passwords are redacted.
# CAMERA_VERBOSE=false

# RTSP URL returned to ONVIF clients; may point to another machine. Do not
# embed credentials. The port must match rtspAddress in the MediaMTX configuration.
# Default: rtsp://CAMERA_ADDRESS:8554/camera (a local MediaMTX).
# CAMERA_RTSP_URL=

# Reported by GetDeviceInformation; the model is also advertised as the
# ONVIF hardware scope.
# CAMERA_MANUFACTURER=Raspberry Pi
# CAMERA_MODEL=Camera Module
# Default: the version of the onvif-camera package.
# CAMERA_FIRMWARE_VERSION=
# Default: a UUID derived from a hash of CAMERA_ID.
# CAMERA_SERIAL_NUMBER=
# CAMERA_HARDWARE_ID=onvif-camera

# Advertised over ONVIF only; match the stream published to MediaMTX.
# If ffprobe (FFmpeg) is installed, unset values are detected from the stream
# at startup; the values shown are used when they cannot be detected.
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=30
# CAMERA_BITRATE=20000
# Set false if the published stream has no audio.
# CAMERA_AUDIO=true
# Advertised AAC audio bitrate (kbit/s), sample rate (Hz, e.g. 44100 or
# 48000) and number of channels (1 = mono, 2 = stereo); 16-bit source.
# CAMERA_AUDIO_BITRATE=128
# CAMERA_AUDIO_SAMPLE_RATE=44100
# CAMERA_AUDIO_CHANNELS=2

# Optional ONVIF WS-Security digest authentication: set BOTH values.
# This does NOT protect RTSP; configure reader access in MediaMTX separately.
# Default: empty (authentication disabled).
# CAMERA_USERNAME=
# CAMERA_PASSWORD=
