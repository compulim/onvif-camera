[Unit]
Description=Raspberry Pi ONVIF camera emulator
Wants=network-online.target rpi-onvif-mediamtx.service
After=network-online.target rpi-onvif-mediamtx.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=onvif-camera
Group=onvif-camera
WorkingDirectory=/opt/rpi-onvif-camera
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/rpi-onvif-camera/camera.env
ExecStart=/usr/bin/env node /opt/rpi-onvif-camera/src/index.js
Restart=always
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
