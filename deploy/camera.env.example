# Set a static address or DHCP reservation for this Raspberry Pi.
CAMERA_ADDRESS=192.168.1.20
CAMERA_NAME="Raspberry Pi Camera"
# Set a unique persistent ID to preserve identity if the IP address changes.
CAMERA_ID=raspberry-pi-camera-1
CAMERA_PORT=8000
CAMERA_RTSP_PORT=8554
CAMERA_DISCOVERY=true

# Advertised over ONVIF only; match the stream published to MediaMTX.
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
CAMERA_BITRATE=2000
# Set false if the published stream has no audio.
CAMERA_AUDIO=true
# Advertised AAC audio bitrate (kbit/s) and sample rate (kHz); 16-bit mono source.
CAMERA_AUDIO_BITRATE=128
CAMERA_AUDIO_SAMPLE_RATE=48

# Optional ONVIF WS-Security digest authentication: set BOTH values.
# This does NOT protect RTSP; configure reader access in mediamtx.yml separately.
CAMERA_USERNAME=
CAMERA_PASSWORD=
